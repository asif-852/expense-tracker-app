    "description": "Full API validation collection for the Expense Tracker MERN app.\nCovers Iterations 0-3: Health, Registration, Login, and Protected Routes.\n\n**Setup:**\n1. Import this collection into Postman\n2. Select the 'Expense Tracker - Local' environment\n3. Make sure your backend is running on http://localhost:5000\n4. Run the collection in order (Collection Runner) or individually",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string",
      "description": "Base URL for all API requests"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string",
      "description": "JWT token – auto-populated after Register or Login"
    }
  ],
