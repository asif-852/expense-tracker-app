    {
      "name": "3. Auth – Protected Routes (Iteration 3)",
      "item": [
        {
          "name": "GET /auth/me – No Token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Iteration 3 core check: protected routes return 401 without token",
                  "pm.test('[Iteration 3] Status code is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Response contains authorization error message', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('msg');",
                  "});",
                  "",
                  "pm.test('No user data exposed in error response', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.not.have.property('username');",
                  "    pm.expect(json).to.not.have.property('email');",
                  "    pm.expect(json).to.not.have.property('token');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Call the protected /me endpoint with NO token header. Must return 401. This is the primary Iteration 3 visible outcome check."
          },
          "response": [
            {
              "name": "401 Unauthorized",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/auth/me",
                  "host": ["{{baseUrl}}"],
                  "path": ["auth", "me"]
                }
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"msg\": \"No token, authorization denied\"\n}"
            }
          ]
        },
        {
          "name": "GET /auth/me – Invalid Token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[Iteration 3] Status code is 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Response contains token validation error', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('msg');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-auth-token",
                "value": "eyJhbGciOiJIUzI1NiJ9.this.is.tampered",
                "description": "A structurally invalid / tampered JWT"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Send a tampered / invalid JWT in the x-auth-token header. The middleware should reject it with 401."
          },
          "response": [
